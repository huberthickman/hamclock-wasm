diff --git a/ESPHamClock/wasm_glue.cpp b/ESPHamClock/wasm_glue.cpp
new file mode 100644
index 0000000..acc4e63
--- /dev/null
+++ b/ESPHamClock/wasm_glue.cpp
@@ -0,0 +1,111 @@
+/* wasm_glue.cpp: entry points the browser page calls to drive the _WEB_ONLY HamClock build.
+ *
+ * HamClock itself runs in a Web Worker (linked with -sPROXY_TO_PTHREAD). The page, on the
+ * browser main thread, reads pixels directly from the shared wasm memory.
+ *
+ * Input must not call into HamClock from the browser main thread: setMouse() and putChar() take
+ * mutexes that HamClock threads may hold while waiting on a call proxied to that same main thread,
+ * which deadlocks. So the page only appends events to a lock-free single-producer queue in shared
+ * memory, and an input thread here drains it and does exactly what liveweb.cpp does for a Live
+ * Web client.
+ */
+
+#if defined(__EMSCRIPTEN__)
+
+#include <atomic>
+#include <emscripten.h>
+#include "HamClock.h"
+
+enum { HCE_MOUSE = 1, HCE_TOUCH = 2, HCE_KEY = 3 };
+
+typedef struct {
+    int type, a, b, c;
+} HCEvent;
+
+#define HCE_N 256
+static HCEvent evq[HCE_N];
+static std::atomic<int> ev_head;                // next to read, written only by input thread
+static std::atomic<int> ev_tail;                // next to write, written only by page
+
+static void dispatch (const HCEvent &e)
+{
+    switch (e.type) {
+
+    case HCE_MOUSE:                             // a,b: app x,y
+        tft.setMouse (e.a, e.b);
+        break;
+
+    case HCE_TOUCH:                             // a,b: app x,y; c: 0 primary else other button
+        if (e.a < 0 || e.a >= tft.width() || e.b < 0 || e.b >= tft.height())
+            break;
+        tft.setMouse (e.a, e.b);
+        wifi_tt_s.x = e.a;
+        wifi_tt_s.y = e.b;
+        wifi_tt_live = true;                    // N.B. before wifi_tt, see liveweb.cpp
+        wifi_tt = e.c ? TT_TAP_BX : TT_TAP;
+        break;
+
+    case HCE_KEY:                               // a: HamClock char (see CHAR_* in ArduinoLib.h)
+        tft.putChar ((char)e.a, e.b != 0, e.c != 0);
+        break;
+    }
+}
+
+static void *inputThread (void *unused)
+{
+    (void) unused;
+    for (;;) {
+        int h = ev_head.load (std::memory_order_relaxed);
+        while (h != ev_tail.load (std::memory_order_acquire)) {
+            dispatch (evq[h]);
+            h = (h + 1) % HCE_N;
+            ev_head.store (h, std::memory_order_release);
+        }
+        usleep (10000);
+    }
+    return (NULL);
+}
+
+extern "C" {
+
+// framebuffer geometry and location of the staged pixels, 0x00RRGGBB per pixel when bpp is 4.
+// pixels is NULL until HamClock has initialized the display.
+EMSCRIPTEN_KEEPALIVE const void *hc_fb_pixels (void) { return (tft.wasmStage()); }
+EMSCRIPTEN_KEEPALIVE int hc_fb_width (void)         { return (tft.wasmStageW()); }
+EMSCRIPTEN_KEEPALIVE int hc_fb_height (void)        { return (tft.wasmStageH()); }
+EMSCRIPTEN_KEEPALIVE int hc_fb_bpp (void)           { return (tft.wasmStageBPP()); }
+
+// increments each time new pixels are staged, so the page can skip redrawing unchanged frames
+extern volatile uint32_t wasm_frames;
+EMSCRIPTEN_KEEPALIVE uint32_t hc_fb_frames (void)   { return (wasm_frames); }
+
+// app coordinate size, ie, what touch and mouse coordinates are in
+EMSCRIPTEN_KEEPALIVE int hc_app_width (void)        { return (tft.width()); }
+EMSCRIPTEN_KEEPALIVE int hc_app_height (void)       { return (tft.height()); }
+
+// start the input thread; call once from the page after callMain()
+EMSCRIPTEN_KEEPALIVE void hc_input_start (void)
+{
+    pthread_t tid;
+    if (pthread_create (&tid, NULL, inputThread, NULL) == 0)
+        pthread_detach (tid);
+}
+
+// queue an input event, never blocks. return 0 if the queue is full.
+EMSCRIPTEN_KEEPALIVE int hc_event (int type, int a, int b, int c)
+{
+    int t = ev_tail.load (std::memory_order_relaxed);
+    int nt = (t + 1) % HCE_N;
+    if (nt == ev_head.load (std::memory_order_acquire))
+        return (0);
+    evq[t].type = type;
+    evq[t].a = a;
+    evq[t].b = b;
+    evq[t].c = c;
+    ev_tail.store (nt, std::memory_order_release);
+    return (1);
+}
+
+} // extern "C"
+
+#endif // __EMSCRIPTEN__
