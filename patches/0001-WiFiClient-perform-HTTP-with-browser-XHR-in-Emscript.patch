From c4d4c92968ed2187a5028edae8559615ccac1824 Mon Sep 17 00:00:00 2001
From: Hubert Hickman <hubert.hickman@gmail.com>
Date: Sun, 1 Nov 2026 21:15:43 -0600
Subject: [PATCH 1/4] WiFiClient: perform HTTP with browser XHR in Emscripten
 builds

Browsers cannot open raw TCP sockets. In __EMSCRIPTEN__ builds, connect()
to port 80/443/8080 creates a virtual connection: write() accumulates the
hand-built HTTP/1.0 request, the first read performs it with a synchronous
XMLHttpRequest (legal because the wasm build runs HamClock in a Web Worker),
and the reply is re-serialized as an HTTP/1.0 response so httpSkipHeader()
and all existing callers work unchanged.

- backend_host requests can be redirected to a CORS-enabled or same-origin
  base URL via the HC_BACKEND_BASE environment variable.
- Browsers forbid setting User-Agent, so HamClock's telemetry UA line is
  forwarded as X-HamClock-UA.
- connectCommand() (curl pipes for https) extracts the URL and fetches it
  directly, delivering only the body as curl would.
- Other ports (DX cluster, APRS-IS, rigctld, gpsd...) fail with a log line.

Native builds are unaffected: all changes are inside #if __EMSCRIPTEN__.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ESPHamClock/ArduinoLib/WiFiClient.cpp | 223 ++++++++++++++++++++++++++
 ESPHamClock/ArduinoLib/WiFiClient.h   |  17 ++
 2 files changed, 240 insertions(+)

diff --git a/ESPHamClock/ArduinoLib/WiFiClient.cpp b/ESPHamClock/ArduinoLib/WiFiClient.cpp
index c6f0b71..88d3c1d 100644
--- a/ESPHamClock/ArduinoLib/WiFiClient.cpp
+++ b/ESPHamClock/ArduinoLib/WiFiClient.cpp
@@ -6,6 +6,132 @@
 #include "IPAddress.h"
 #include "WiFiClient.h"
 
+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+
+/* browser build glue.
+ * Perform one HTTP GET with a synchronous XMLHttpRequest. This is only legal off the browser's
+ * main thread, which is why the wasm build is linked with -sPROXY_TO_PTHREAD: all of HamClock
+ * runs in a Web Worker and may block here exactly like it blocks in read(2) on a real socket.
+ *
+ * req/req_len: the raw HTTP/1.0 request HamClock wrote, or (host empty) a bare URL from curl mode.
+ * base: if not empty, replaces scheme://host[:port] -- used to point backend_host traffic at a
+ *   CORS-enabled or same-origin URL such as "https://ohb.hamclock.app" or "/ohb".
+ * Browsers will not let scripts set User-Agent, so HamClock's (telemetry-laden) UA line is
+ *   forwarded as X-HamClock-UA instead.
+ * Returns length of the synthesized response (status line + headers + body, or body only),
+ *   left in a worker-global for hc_wasm_http_take(), or -1 on network/CORS failure.
+ */
+EM_JS(int, hc_wasm_http_fetch, (const char *req, int req_len, const char *host, int port,
+                                int body_only, const char *base), {
+    var reqs = UTF8ToString(req, req_len);
+    var hostS = UTF8ToString(host);
+    var baseS = UTF8ToString(base);
+    var url, ims = null, ua = null;
+    if (hostS.length == 0) {
+        url = reqs.trim();
+    } else {
+        var lines = reqs.split('\r\n');
+        var m = lines[0].split(' ');            // "GET /path HTTP/1.0" (no regex: EM_JS mangles backslashes)
+        if (m.length < 3 || m[0] != 'GET') { console.warn('HamClock: unexpected request ' + lines[0]); return -1; }
+        for (var i = 1; i < lines.length; i++) {
+            var k = lines[i].indexOf(':');
+            if (k < 0) continue;
+            var name = lines[i].substring(0, k).trim().toLowerCase();
+            var val = lines[i].substring(k+1).trim();
+            if (name == 'if-modified-since') ims = val;
+            else if (name == 'user-agent') ua = val;
+        }
+        var origin = baseS.length ? baseS
+                   : (port == 443 ? 'https://' : 'http://') + hostS + ((port == 80 || port == 443) ? '' : ':' + port);
+        url = origin + m[1];
+    }
+    var xhr = new XMLHttpRequest();
+    try {
+        xhr.open('GET', url, false);
+        xhr.responseType = 'arraybuffer';
+        if (ims) xhr.setRequestHeader('If-Modified-Since', ims);
+        if (ua) xhr.setRequestHeader('X-HamClock-UA', ua);
+        xhr.send();
+    } catch (e) {
+        console.warn('HamClock: GET ' + url + ' failed: ' + e);
+        return -1;
+    }
+    if (xhr.status == 0) {
+        console.warn('HamClock: GET ' + url + ' network or CORS error');
+        return -1;
+    }
+    var body = new Uint8Array(xhr.response || new ArrayBuffer(0));
+    var out = body;
+    if (!body_only) {
+        var hdr = 'HTTP/1.0 ' + xhr.status + ' ' + (xhr.statusText || 'OK') + '\r\n';
+        var all = (xhr.getAllResponseHeaders() || '').split('\r\n');
+        for (var j = 0; j < all.length; j++) {
+            var c = all[j].indexOf(':');
+            if (c <= 0) continue;
+            var hn = all[j].substring(0, c).trim().toLowerCase();
+            // the browser already undid any transfer/content encoding
+            if (hn == 'content-length' || hn == 'content-encoding' || hn == 'transfer-encoding'
+                        || hn == 'connection')
+                continue;
+            hdr += all[j] + '\r\n';
+        }
+        hdr += 'Content-Length: ' + body.length + '\r\nConnection: close\r\n\r\n';
+        var h = new TextEncoder().encode(hdr);
+        out = new Uint8Array(h.length + body.length);
+        out.set(h, 0);
+        out.set(body, h.length);
+    }
+    self.__hc_resp = out;
+    return out.length;
+});
+
+EM_JS(void, hc_wasm_http_take, (uint8_t *dst), {
+    HEAPU8.set(self.__hc_resp, dst);
+    self.__hc_resp = null;
+});
+
+static int wasm_next_fd = 100000;         // fake fds for virtual connections, never passed to libc
+
+void WiFiClient::wasmReset()
+{
+    if (m_req) free (m_req);
+    if (m_resp) free (m_resp);
+    m_req = nullptr;
+    m_resp = nullptr;
+    m_req_len = m_req_max = 0;
+    m_resp_len = m_resp_pos = 0;
+    m_isHttp = m_bodyOnly = m_fetched = false;
+    m_host[0] = '\0';
+    m_port = 0;
+}
+
+bool WiFiClient::wasmPerform()
+{
+    m_fetched = true;
+
+    // backend_host traffic may be redirected to a CORS-enabled or same-origin base
+    const char *base = "";
+    const char *be = getenv ("HC_BACKEND_BASE");
+    if (be && m_host[0] && strcmp (m_host, backend_host) == 0)
+        base = be;
+
+    int n = hc_wasm_http_fetch (m_req ? m_req : "", m_req_len, m_host, m_port, m_bodyOnly, base);
+    if (n < 0)
+        return (false);
+    m_resp = (uint8_t *) malloc (n > 0 ? n : 1);
+    if (!m_resp)
+        return (false);
+    hc_wasm_http_take (m_resp);
+    m_resp_len = n;
+    m_resp_pos = 0;
+    if (debugLevel (DEBUG_NET, 1))
+        printf ("WiFiCl: wasm GET %s:%d -> %d bytes\n", m_host[0] ? m_host : "(url)", m_port, n);
+    return (true);
+}
+
+#endif // __EMSCRIPTEN__
+
 // default constructor
 WiFiClient::WiFiClient()
 {
@@ -16,6 +142,11 @@ WiFiClient::WiFiClient()
     read_pending_ms = get_timeout_ms();
     m_isPipe = false;
     m_pipe = nullptr;
+#if defined(__EMSCRIPTEN__)
+    m_req = nullptr;
+    m_resp = nullptr;
+    wasmReset();
+#endif
 }
 
 // constructor handed an open socket to use
@@ -30,6 +161,11 @@ WiFiClient::WiFiClient(int fd)
     next_peek = 0;
     m_isPipe = false;
     m_pipe = nullptr;
+#if defined(__EMSCRIPTEN__)
+    m_req = nullptr;
+    m_resp = nullptr;
+    wasmReset();
+#endif
 }
 
 // return whether this socket is active
@@ -110,6 +246,26 @@ extern "C" bool android_connect_http(const char *cmd, int *read_fd);
 
 bool WiFiClient::connectCommand(const char* command)
 {
+#if defined(__EMSCRIPTEN__)
+    // no processes in a browser: pull the URL out of the curl command and fetch it directly.
+    // curl prints only the body, so deliver it without headers.
+    stop();
+    const char *u = strstr (command, "https://");
+    if (!u)
+        u = strstr (command, "http://");
+    if (!u)
+        return (false);
+    int ul = strcspn (u, " \"'");
+    m_isHttp = true;
+    m_bodyOnly = true;
+    m_req = (char *) malloc (ul + 1);
+    memcpy (m_req, u, ul);
+    m_req[ul] = '\0';
+    m_req_len = m_req_max = ul;
+    socket = wasm_next_fd++;
+    n_peek = next_peek = 0;
+    return (true);
+#endif
     /* clean up any previous pipe */
     if (m_pipe) {
         pclose(m_pipe);
@@ -161,6 +317,23 @@ bool WiFiClient::connect(const char *host, int port)
     /* connect is not a command pipe so clear pipe information */
     m_isPipe = false;
     m_pipe = nullptr;
+
+#if defined(__EMSCRIPTEN__)
+    // browser build: HTTP becomes a virtual connection performed later with XHR; browsers can
+    // not open raw TCP (DX cluster, APRS-IS, rigctld, gpsd...) without a WebSocket relay.
+    stop();
+    if (port == 80 || port == 443 || port == 8080) {
+        m_isHttp = true;
+        snprintf (m_host, sizeof(m_host), "%s", host);
+        m_port = port;
+        socket = wasm_next_fd++;
+        n_peek = next_peek = 0;
+        return (true);
+    }
+    printf ("WiFiCl: %s:%d: raw TCP is not available in the browser build\n", host, port);
+    errno = ENOTSUP;
+    return (false);
+#endif
     /* lookup host address.
      * N.B. must call freeaddrinfo(aip) after successful call before returning
      */
@@ -216,6 +389,9 @@ bool WiFiClient::connect(IPAddress ip, int port)
 void WiFiClient::setNoDelay(bool on)
 {
     // control Nagle algorithm
+#if defined(__EMSCRIPTEN__)
+    if (m_isHttp) return;
+#endif
     socklen_t flag = on;
     if (setsockopt(socket, IPPROTO_TCP, TCP_NODELAY, (void *) &flag, sizeof(flag)) < 0)
         printf ("WiFiCl: TCP_NODELAY(%d): %s\n", on, strerror(errno));     // not fatal
@@ -223,6 +399,15 @@ void WiFiClient::setNoDelay(bool on)
 
 void WiFiClient::stop()
 {
+#if defined(__EMSCRIPTEN__)
+    if (m_isHttp) {
+        wasmReset();
+        socket = -1;
+        n_peek = 0;
+        next_peek = 0;
+        return;
+    }
+#endif
     if (m_isPipe) {
         if (m_pipe != nullptr) {
             pclose(m_pipe);
@@ -292,6 +477,27 @@ int WiFiClient::available (int pending_ms)
     if (next_peek < n_peek)
         return (1);
 
+#if defined(__EMSCRIPTEN__)
+    if (m_isHttp) {
+        if (!m_fetched && !wasmPerform()) {
+            stop();
+            return (0);
+        }
+        if (m_resp_pos < m_resp_len) {
+            int n = m_resp_len - m_resp_pos;
+            if (n > (int)sizeof(peek))
+                n = sizeof(peek);
+            memcpy (peek, m_resp + m_resp_pos, n);
+            m_resp_pos += n;
+            n_peek = n;
+            next_peek = 0;
+            return (1);
+        }
+        stop();                             // like EOF on a real socket
+        return (0);
+    }
+#endif
+
     // wait as instructed
     if (!pending(pending_ms))
         return (0);
@@ -363,6 +569,19 @@ int WiFiClient::write (const uint8_t *buf, int n)
     if (socket < 0)
         return (0);
 
+#if defined(__EMSCRIPTEN__)
+    if (m_isHttp) {
+        if (m_req_len + n + 1 > m_req_max) {
+            m_req_max = (m_req_len + n + 1) * 2;
+            m_req = (char *) realloc (m_req, m_req_max);
+        }
+        memcpy (m_req + m_req_len, buf, n);
+        m_req_len += n;
+        m_req[m_req_len] = '\0';
+        return (n);
+    }
+#endif
+
     int nw = 0;
     for (int ntot = 0; ntot < n; ntot += nw) {
         nw = ::write (socket, buf+ntot, n-ntot);
@@ -494,6 +713,10 @@ void WiFiClient::println (uint32_t i)
 
 IPAddress WiFiClient::remoteIP()
 {
+#if defined(__EMSCRIPTEN__)
+    if (m_isHttp)
+        return (IPAddress(0,0,0,0));
+#endif
     struct sockaddr_in sa;
     socklen_t len = sizeof(sa);
 
diff --git a/ESPHamClock/ArduinoLib/WiFiClient.h b/ESPHamClock/ArduinoLib/WiFiClient.h
index e27c420..d4489f0 100644
--- a/ESPHamClock/ArduinoLib/WiFiClient.h
+++ b/ESPHamClock/ArduinoLib/WiFiClient.h
@@ -79,6 +79,23 @@ private:
     bool m_isPipe;
     FILE* m_pipe;
 
+#if defined(__EMSCRIPTEN__)
+    // browser build: no raw sockets. HTTP "connections" are virtual: writes accumulate the
+    // request, the first read performs it with a synchronous XHR (legal because HamClock runs
+    // in a Web Worker under PROXY_TO_PTHREAD), and reads then drain the synthesized response.
+    bool m_isHttp;                          // this is a virtual HTTP connection
+    bool m_bodyOnly;                        // curl-style: deliver body without headers
+    bool m_fetched;                         // request has been performed
+    char m_host[128];                       // host as given to connect()
+    int m_port;                             // port as given to connect()
+    char *m_req;                            // accumulated request text
+    int m_req_len, m_req_max;
+    uint8_t *m_resp;                        // malloced synthesized response
+    int m_resp_len, m_resp_pos;
+    void wasmReset();
+    bool wasmPerform();
+#endif
+
 };
 
 
